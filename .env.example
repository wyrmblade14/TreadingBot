# ── Zerodha Kite Connect API ──────────────────────────────────────────
# Get these from https://developers.kite.trade/
# Step 1: Create an app at the Kite Developer Console
# Step 2: Subscribe to Kite Connect API (₹2000/month)
# Step 3: Set callback URL to http://127.0.0.1

KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=                               # Auto-filled each morning by the bot

# Kite Connect app Redirect URL — set this ONCE in Kite Developer Console:
#
#   docker-compose up  (direct):   http://<tailscale-ip>:7777
#   make prod-up       (Nginx):    http://<tailscale-ip>/kite/callback
#
# After setting this, /kite_login in Telegram becomes a single tap — no URL pasting.

# ── Automated Daily Login (RECOMMENDED — zero human intervention) ─────
# The bot will automatically refresh the Kite token every morning at 8:30 AM.
# Set these three variables once; the bot handles everything after that.
#
# ZERODHA_TOTP_SECRET — the base32 seed (NOT the 6-digit code).
#   How to get it:
#     1. Zerodha Console → My Profile → Security → Two-factor authentication
#     2. Click "Enable TOTP" → scan QR code with your authenticator app
#     3. ALSO click "Show secret key" → copy the raw base32 string here
#        (looks like: JBSWY3DPEHPK3PXP)
#   This lets the bot generate the 6-digit code programmatically.
#
# If these are left empty, the bot will fall back to Telegram-based
# login (you tap a URL on your phone) or manual `make login`.

ZERODHA_USER_ID=your_zerodha_client_id           # e.g. AB1234
ZERODHA_PASSWORD=your_zerodha_password
ZERODHA_TOTP_SECRET=your_totp_base32_secret      # base32 seed, NOT the 6-digit code

# ── Trading Mode ──────────────────────────────────────────────────────
# "paper" = simulated trading (safe, no real money)
# "live"  = real money (only after 30+ days of successful paper trading)
TRADING_MODE=paper

# ── Paper Trading Capital ─────────────────────────────────────────────
# Starting virtual balance for paper trading (in INR)
VIRTUAL_CAPITAL=100000

# ── Telegram Notifications (optional) ────────────────────────────────
# Get trade alerts on your phone — new entries, exits, daily P&L summary.
# Leave blank to disable (the bot still works normally without this).
#
# Setup (5 minutes):
#   1. Open Telegram → search @BotFather → send /newbot → follow prompts
#   2. Copy the token BotFather gives you into TELEGRAM_BOT_TOKEN below
#   3. Start a chat with your new bot (search its username and press Start)
#   4. Visit https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates in a browser
#      and copy the "id" value under "chat" into TELEGRAM_CHAT_ID below

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── PostgreSQL Database ───────────────────────────────────────────────
# Inside Docker the host is the service name "postgres".
# Outside Docker (running scripts directly) change the host to "localhost".
#
# DATABASE_URL format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL is required — the app will not start without it.
POSTGRES_USER=treadingbot
POSTGRES_PASSWORD=changeme_before_production
POSTGRES_DB=treadingbot
DATABASE_URL=postgresql://treadingbot:changeme_before_production@postgres:5432/treadingbot

# ── React Dashboard ──────────────────────────────────────────────────
# NEXT_PUBLIC_DASHBOARD_API_URL — URL your browser uses to reach the Python API.
#
#   Local dev:    http://localhost:8000
#   Oracle Cloud: http://<your-tailscale-hostname>   ← NO port needed (Nginx on port 80)
#
# Tailscale hostnames look like: http://oracle-instance.tail1234.ts.net
# Or just use the Tailscale IP:  http://100.x.x.x
#
# This is baked into the Next.js bundle at build time.
# If you change it: make prod-deploy
#
NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:8000
DASHBOARD_API_INTERNAL_URL=http://dashboard-api:8000
DASHBOARD_API_HOST=0.0.0.0
DASHBOARD_API_PORT=8000

# ── Oracle Cloud Vault (optional — secrets stored in OCI Vault instead of .env) ──
# After running `make oci-setup-services`, copy the Vault OCID here.
# Then run `python3 scripts/oci_vault_push.py` once to push secrets from .env to Vault.
# Once set, the bot will load secrets from Vault at startup (with .env as fallback).
# Leave blank to use .env only (fine for local dev, not recommended for production).
OCI_VAULT_ID=
