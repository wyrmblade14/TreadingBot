# Ensure shell scripts always use LF line endings (required for bash on Mac/Linux)
*.sh    text eol=lf

# Python, JSON, Markdown, and text files use LF
*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Windows batch/PowerShell files use CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
